# Local fidelity-run scratch space: production repro documents and pack caches.
# Never committable — a stray `git add -A` would push user files public.
/working_dir/

# One-off verification tests kept while chasing a fix; promote to a real test
# file (or delete) instead of committing them under this name.
_scratch-*

# ZCode CLI session state
.zcode/

# Local deployment secrets (never commit; see resources/*.json $comment)
apps/shell/resources/*.local.json
# production-site factory config (FANGTANG_BUILD_ENV=production); CI writes it
# from the FANGTANG_DEFAULTS_PROD_JSON secret — see apps/shell/resources/
apps/shell/resources/fangtang-defaults.prod.json

tmp/

# Local planning/context notes (per-session, never commit)
CONTEXT.md
findings.md
progress.md
task_plan.md
.planning/
.local/

# E2E probe live tokens (never commit)
scripts/.e2e-*
