{
  "name": "@genoffice/knowledge-service",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Isolated knowledge API/worker runtime and shared pure policies",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime/index.ts",
    "./parsing": "./src/parsing/index.ts"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start:api": "node dist/api.mjs",
    "start:worker": "node dist/worker.mjs",
    "maintain:queue": "node dist/maintenance.mjs",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:apply:local": "node --experimental-strip-types integration/apply-local.mjs",
    "db:apply:immutable:local": "node --experimental-strip-types integration/apply-immutable-local.mjs",
    "db:apply:content:local": "node --experimental-strip-types integration/apply-build-content-local.mjs",
    "db:apply:queue:local": "node --experimental-strip-types integration/apply-queue-local.mjs",
    "db:apply:build-lifecycle:local": "node --experimental-strip-types integration/apply-build-lifecycle-local.mjs",
    "db:apply:publish:local": "node --experimental-strip-types integration/apply-build-publish-local.mjs",
    "db:apply:capacity:local": "node --experimental-strip-types integration/apply-capacity-local.mjs",
    "db:apply:replacement:local": "node --experimental-strip-types integration/apply-replacement-local.mjs",
    "db:apply:cancellation:local": "node --experimental-strip-types integration/apply-cancellation-local.mjs",
    "db:apply:cancellation-publish:local": "node --experimental-strip-types integration/apply-cancellation-publish-local.mjs",
    "db:apply:cancellation-worker:local": "node --experimental-strip-types integration/apply-cancellation-worker-local.mjs",
    "db:apply:retry:local": "node --experimental-strip-types integration/apply-retry-local.mjs",
    "db:apply:capacity-publish:local": "node --experimental-strip-types integration/apply-capacity-publish-local.mjs",
    "db:apply:worker-lock-order:local": "node --experimental-strip-types integration/apply-worker-lock-order-local.mjs",
    "db:apply:worker-phase-lock:local": "node --experimental-strip-types integration/apply-worker-phase-lock-local.mjs",
    "db:apply:operation-attempt-binding:local": "node --experimental-strip-types integration/apply-operation-attempt-binding-local.mjs",
    "db:apply:operation-attempt-fence:local": "node --experimental-strip-types integration/apply-operation-attempt-fence-local.mjs",
    "db:apply:deletion-tombstone:local": "node --experimental-strip-types integration/apply-deletion-tombstone-local.mjs",
    "db:apply:deletion-empty-space:local": "node --experimental-strip-types integration/apply-deletion-empty-space-local.mjs",
    "db:apply:operation-fail:local": "node --experimental-strip-types integration/apply-operation-fail-local.mjs",
    "db:apply:operation-rebind:local": "node --experimental-strip-types integration/apply-operation-rebind-local.mjs",
    "db:apply:build-gc:local": "node --experimental-strip-types integration/apply-build-gc-local.mjs",
    "db:apply:storage-window:local": "node --experimental-strip-types integration/apply-storage-window-local.mjs",
    "db:apply:embedding-attempt:local": "node --experimental-strip-types integration/apply-embedding-attempt-local.mjs",
    "db:apply:upload-preparation:local": "node --experimental-strip-types integration/apply-upload-preparation-local.mjs",
    "db:apply:upload-completion:local": "node --experimental-strip-types integration/apply-upload-completion-local.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:database": "vitest run --config vitest.database.config.ts"
  },
  "dependencies": {
    "@genoffice/knowledge-contract": "*",
    "fast-xml-parser": "5.10.1",
    "jose": "6.2.12",
    "pdfjs-dist": "^6.2.108",
    "pg": "8.23.1",
    "pg-boss": "12.37.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "esbuild": "0.25.12",
    "pdf-lib": "^1.17.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
