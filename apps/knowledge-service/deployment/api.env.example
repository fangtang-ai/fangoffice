KNOWLEDGE_ENVIRONMENT=production
KNOWLEDGE_DATABASE_NAME=
KNOWLEDGE_API_DATABASE_ROLE=
KNOWLEDGE_API_DATABASE_URL=
KNOWLEDGE_AUTH_ISSUER=
KNOWLEDGE_AUTH_AUDIENCE=
KNOWLEDGE_AUTH_REQUIRED_SCOPES=
KNOWLEDGE_API_HOST=127.0.0.1
KNOWLEDGE_API_PORT=4180
KNOWLEDGE_DELETION_JOURNAL_DIR=
# Explicit positive byte limit; omit this variable to disable upload preparation.
KNOWLEDGE_UPLOAD_MAXIMUM_FILE_BYTES=
# Optional OSS V4 uploads: uncomment/fill ALL entries using short-lived STS credentials.
# Verify a dedicated private bucket with versioning disabled before enabling.
# KNOWLEDGE_UPLOAD_OSS_BUCKET=
# KNOWLEDGE_UPLOAD_OSS_REGION=
# KNOWLEDGE_UPLOAD_OSS_VERSIONING=disabled
# KNOWLEDGE_UPLOAD_OSS_ACCESS_KEY_ID=
# KNOWLEDGE_UPLOAD_OSS_ACCESS_KEY_SECRET=
# KNOWLEDGE_UPLOAD_OSS_SECURITY_TOKEN=
# KNOWLEDGE_UPLOAD_OSS_CREDENTIAL_EXPIRES_AT=
